generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  OPEN
  PARTIALLY_LOCKED
  LOCKED
  CLOSED
  CANCELLED
}

enum OrderStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DEFAULTED
}

enum PaymentStatusType {
  PENDING
  PARTIAL
  PAID
  DELAYED
  DEFAULTED
}

enum TransactionType {
  ESCROW_LOGICAL
  COMMISSION
  PAYOUT
}

enum BlacklistReason {
  FARMER_DEFAULT
  BUYER_PAYMENT_DELAY
  FRAUD_RISK
  ADMIN_ACTION
}

enum RatingType {
  FARMER_TO_BUYER
  BUYER_TO_FARMER
  ADMIN_AUDIT
}

model User {
  id                 String              @id @default(cuid())
  phoneNumber        String              @unique
  role               UserRole
  fullName           String
  districtId         String
  verificationStatus VerificationStatus  @default(PENDING)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  district           District            @relation(fields: [districtId], references: [id])
  farmerProfile      FarmerProfile?
  buyerProfile       BuyerProfile?
  ordersAsBuyer      Order[]             @relation("BuyerOrders")
  listingsAsFarmer   ProductListing[]    @relation("FarmerListings")
  givenRatings       Rating[]            @relation("GivenRatings")
  receivedRatings    Rating[]            @relation("ReceivedRatings")
  blacklistEntries   Blacklist[]
  managedClusters    Cluster[]           @relation("ClusterManager")
}

model FarmerProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  clusterId          String?
  defaultCount       Int         @default(0)
  suspensionEndsAt   DateTime?
  isPermanentlyBanned Boolean    @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User        @relation(fields: [userId], references: [id])
  cluster            Cluster?    @relation(fields: [clusterId], references: [id])
}

model BuyerProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  companyName        String
  paymentDelayCount  Int         @default(0)
  suspensionEndsAt   DateTime?
  isBlacklisted      Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User        @relation(fields: [userId], references: [id])
}

model Cluster {
  id                 String          @id @default(cuid())
  name               String
  districtId         String
  managerId          String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  district           District        @relation(fields: [districtId], references: [id])
  manager            User?           @relation("ClusterManager", fields: [managerId], references: [id])
  farmers            FarmerProfile[]
}

model District {
  id                 String          @id @default(cuid())
  name               String          @unique
  state              String          @default("Bihar")
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())

  users              User[]
  clusters           Cluster[]
  listings           ProductListing[]
}

model ProductListing {
  id                 String          @id @default(cuid())
  farmerId           String
  districtId         String
  cropName           String
  quantityKg         Int
  pricePerKg         Decimal         @db.Decimal(10, 2)
  minimumOrderKg     Int             @default(100)
  status             ListingStatus   @default(OPEN)
  isVerified         Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  farmer             User            @relation("FarmerListings", fields: [farmerId], references: [id])
  district           District        @relation(fields: [districtId], references: [id])
  orders             Order[]
}

model Order {
  id                 String            @id @default(cuid())
  listingId          String
  buyerId            String
  farmerId           String
  lockedQuantityKg   Int
  lockedPricePerKg   Decimal           @db.Decimal(10, 2)
  commissionPercent  Decimal           @default(2.0) @db.Decimal(4, 2)
  totalAmount        Decimal           @db.Decimal(12, 2)
  commissionAmount   Decimal           @db.Decimal(12, 2)
  finalPayoutAmount  Decimal           @db.Decimal(12, 2)
  status             OrderStatus       @default(LOCKED)
  lockNotes          String?
  lockedAt           DateTime          @default(now())
  completedAt        DateTime?

  listing            ProductListing    @relation(fields: [listingId], references: [id])
  buyer              User              @relation("BuyerOrders", fields: [buyerId], references: [id])
  paymentStatus      PaymentStatus?
  transactions       Transaction[]
}

model PaymentStatus {
  id                 String            @id @default(cuid())
  orderId            String            @unique
  status             PaymentStatusType @default(PENDING)
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?

  order              Order             @relation(fields: [orderId], references: [id])
}

model Transaction {
  id                 String            @id @default(cuid())
  orderId            String
  type               TransactionType
  amount             Decimal           @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime          @default(now())

  order              Order             @relation(fields: [orderId], references: [id])
}

model Blacklist {
  id                 String            @id @default(cuid())
  userId             String
  reason             BlacklistReason
  active             Boolean           @default(true)
  details            String?
  createdAt          DateTime          @default(now())

  user               User              @relation(fields: [userId], references: [id])
}


model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Rating {
  id                 String            @id @default(cuid())
  fromUserId         String
  toUserId           String
  orderId            String?
  score              Int
  comments           String?
  type               RatingType
  createdAt          DateTime          @default(now())

  fromUser           User              @relation("GivenRatings", fields: [fromUserId], references: [id])
  toUser             User              @relation("ReceivedRatings", fields: [toUserId], references: [id])
}
